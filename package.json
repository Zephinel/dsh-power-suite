{
  "name": "@zephinel/dsh-power-suite",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zephinel/dsh-power-suite.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "One DeepSeek Harness Web plugin that adds session artifacts, Dynamic Workspaces, prompt history, draft attachment memory, interrupted-session recovery, UI element annotation, a Host-synced sidebar width, and their settings.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale",
    "assets",
    "docs",
    "release-notes",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "PRODUCT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "icon": "./icon.png",
  "scripts": {
    "check": "node scripts/check.mjs && npm run pack:check",
    "test": "node --test test/*.test.js",
    "pack:check": "npm pack --dry-run --json",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "check:docs-links": "node scripts/check-docs-links.mjs",
    "check:publish-manifest": "node scripts/check-publish-manifest.mjs",
    "build:readme-bento": "node scripts/build-readme-bento.mjs",
    "capture:readme-shots": "node test/browser/sidebar.e2e.mjs --readme-shots"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "power-suite",
    "artifacts",
    "prompt-history",
    "dynamic-workspaces",
    "interrupted-sessions",
    "ui-annotation",
    "sidebar-width"
  ],
  "author": "rexxin",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
