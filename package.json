{
  "name": "@rexxin/dsh-power-suite",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "One DeepSeek Harness Web plugin that adds session artifacts, per-Workspace default agent presets, composer prompt history, interrupted-session recovery, and their settings.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "PRODUCT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "icon": "./icon.png",
  "scripts": {
    "check": "node scripts/check.mjs && npm run pack:check",
    "test": "node --test test/*.test.js",
    "pack:check": "npm pack --dry-run --json"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "power-suite",
    "artifacts",
    "prompt-history"
  ],
  "author": "rexxin",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
